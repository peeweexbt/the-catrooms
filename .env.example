ANTHROPIC_API_KEY=sk-ant-your-key-here

# X (Twitter) posting — used by post_to_x.py, not by the scheduled generation
# tasks. Generate these in the X developer console: API Key/Secret are the
# app's "Consumer Keys"; Access Token/Secret are generated separately under
# "Keys and tokens" after the app is switched to Read and Write permissions.
X_API_KEY=your_consumer_key_here
X_API_SECRET=your_consumer_secret_here
X_ACCESS_TOKEN=your_access_token_here
X_ACCESS_TOKEN_SECRET=your_access_token_secret_here
